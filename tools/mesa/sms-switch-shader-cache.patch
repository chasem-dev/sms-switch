diff --git a/src/util/disk_cache.h b/src/util/disk_cache.h
index e5dca8e..b3b36cd 100644
--- a/src/util/disk_cache.h
+++ b/src/util/disk_cache.h
@@ -138,8 +138,18 @@ disk_cache_get_function_identifier(void *ptr, struct mesa_sha1 *ctx)
 static inline bool
 disk_cache_get_function_identifier(void *ptr, struct mesa_sha1 *ctx)
 {
+#ifdef __SWITCH__
+   /* No shared objects to time-stamp on the Switch: the cache's identity is
+    * this build's (MESA_SWITCH_CACHE_ID, from the build), so a rebuilt Mesa
+    * never reads another build's entries. */
+   static const char id[] = MESA_SWITCH_CACHE_ID;
+   (void) ptr;
+   _mesa_sha1_update(ctx, id, sizeof(id) - 1);
+   return true;
+#else
    return false;
 #endif
+#endif
 }
 
