+/* The index lives in memory on the Switch: write `len` changed bytes at
+ * `at` (within cache->index_mmap) back to the file. */
+static mtx_t index_write_lock = _MTX_INITIALIZER_NP;
+static void
+index_written(struct disk_cache *cache, const void *at, size_t len)
+{
+   const off_t off = (const uint8_t *) at - cache->index_mmap;
+   mtx_lock(&index_write_lock);
+   if (lseek(cache->index_fd, off, SEEK_SET) == off)
+      (void) !write(cache->index_fd, at, len);
+   mtx_unlock(&index_write_lock);
+}
+#define INDEX_WRITTEN(cache, at, len) index_written(cache, at, len)
+#else
+#define INDEX_WRITTEN(cache, at, len) ((void)0)
