+++ b/source/maxwell/gpu_3d_vbo.cpp
@@ -54,7 +54,7 @@ void dkCmdBufBindVtxBuffers(DkCmdBuf obj, uint32_t firstId, DkBufExtents const b
 	DK_DEBUG_BAD_INPUT(firstId > DK_MAX_VERTEX_BUFFERS || numBuffers > DK_MAX_VERTEX_BUFFERS || (firstId+numBuffers) > DK_MAX_VERTEX_BUFFERS);
 	DK_DEBUG_NON_NULL_ARRAY(buffers, numBuffers);
 	CmdBufWriter w{obj};
-	w.reserve(5*numBuffers);
+	w.reserve(6*numBuffers); // VertexArray::Start and VertexArrayLimit: 3 words each
 
 	for (uint32_t i = 0; i < numBuffers; i ++)
 	{
