diff --git a/source/uam_api.cpp b/source/uam_api.cpp
new file mode 100644
index 0000000..713de40
--- /dev/null
+++ b/source/uam_api.cpp
@@ -0,0 +1,18 @@
+#include "uam_api.h"
+#include "compiler_iface.h"
+
+extern bool g_uamKeepFrontend; // compiler_iface.cpp
+
+int uam_compile_dksh(const char* glsl, enum uam_stage stage, void** dksh, size_t* size)
+{
+	// The front end's types and built-in functions are made once and kept:
+	// making them again for every shader costs more than most compiles.
+	g_uamKeepFrontend = true;
+	*dksh = NULL;
+	*size = 0;
+	DekoCompiler compiler{(pipeline_stage)stage};
+	if (!compiler.CompileGlsl(glsl))
+		return 0;
+	compiler.GetDksh(dksh, size);
+	return *dksh != NULL;
+}
diff --git a/source/uam_api.h b/source/uam_api.h
new file mode 100644
index 0000000..4affd35
--- /dev/null
+++ b/source/uam_api.h
@@ -0,0 +1,18 @@
+// libuam's C interface: GLSL in, a DKSH shader module in memory out.
+#pragma once
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum uam_stage { UAM_STAGE_VERTEX = 0, UAM_STAGE_GEOMETRY = 3, UAM_STAGE_FRAGMENT = 4, UAM_STAGE_COMPUTE = 5 };
+
+// Compiles one stage's GLSL. On success *dksh is the module (free() it) and
+// the result is 1; on failure 0, with the compiler's messages on stderr.
+// Not thread-safe: one compile at a time.
+int uam_compile_dksh(const char* glsl, enum uam_stage stage, void** dksh, size_t* size);
+
+#ifdef __cplusplus
+}
+#endif
