 std::string s_renderer;
 
+// GXPC_SetBuildLabel's
+char s_buildLabel[128];
+double s_buildLabelSeconds = 0;
+
+// The build label alone in the lower-left corner for its first seconds.
+void drawBuildLabel(int winW, int winH) {
+    static double shownFrom = 0;
+    static bool done = false;
+    if (done || !s_buildLabel[0]) return;
+    const double t = nowSeconds();
+    if (!shownFrom) shownFrom = t;
+    if (t - shownFrom > s_buildLabelSeconds) {
+        done = true;
+        return;
+    }
+    static std::vector<uint8_t> px;
+    static int w = 0, h = 0;
+    if (px.empty()) {
+        const int pad = 3;
+        w = stb_easy_font_width(s_buildLabel) + pad * 2;
+        h = stb_easy_font_height(s_buildLabel) + pad * 2;
+        px.assign(size_t(w) * h * 4, 0);
+        const uint8_t bg[4] = {16, 16, 24, 160}, fg[4] = {255, 255, 255, 230};
+        gx::overlayFillRect(px, w, h, 0, 0, w, h, bg);
+        gx::overlayText(px, w, h, pad, pad, s_buildLabel, fg);
+    }
+    // (sent each frame: a small bitmap, for a few seconds)
+    const int scale = winH >= 720 ? 2 : 1;
+    gx::drawOverlayPanel(gx::OVERLAY_BUILD_LABEL, px.data(), w, h, 8, winH - h * scale - 8, scale, winW, winH);
+}
+
 }  // namespace
 
