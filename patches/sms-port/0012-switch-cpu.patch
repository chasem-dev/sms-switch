+// of its own: the audio thread releases the DSP and then waits for the
+// subframe's mail, so the game's other threads have the CPU meanwhile instead
+// of the mixing taking its turn. The mail is raised (the interrupt source
+// below) once the subframe is mixed. JAudio writes the voices it hands the
+// DSP only between that mail and the next release, as it must on hardware.
+// SMS_AUDIO_DSP_THREAD=0/1 (on by default on the Switch, never with the
+// deterministic retrace clock).
+struct Mixer {
+	std::mutex mu;
+	std::condition_variable cv;
+	bool job; // under mu
+	int16_t* outA;
+	int16_t* outB;
+	int n;
+	u16 master;
+	std::atomic<int> busy; // released and its mail not yet raised (game threads)
+	std::atomic<int> done; // mixed (the mixing thread)
+	bool started;
