+
+// A command while a subframe is still being mixed (JAudio waits for the mail
+// first, so this only guards the DSP's state): the mixing finishes first.
+void mixer_wait()
+{
+	while (m.busy.load(std::memory_order_relaxed) && !m.done.load(std::memory_order_acquire))
+		std::this_thread::yield();
+}
+
+void mixer_start()
+{
+	if (m.started || !mixer_thread_on())
+		return;
+	pthread_t th;
+	pthread_attr_t a;
+	pthread_attr_init(&a);
+	pthread_attr_setstacksize(&a, 256 << 10);
+	const int rc = pthread_create(&th, &a, mixer_loop, NULL);
+	pthread_attr_destroy(&a);
