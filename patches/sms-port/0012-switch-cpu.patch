+
+bool mixer_thread_on()
+{
+	static int on = -1;
+	if (on < 0) {
+		const char* e = getenv("SMS_AUDIO_DSP_THREAD");
+#ifdef __SWITCH__
+		on = !(e && *e == '0');
+#else
+		on = e && *e == '1';
+#endif
+		if (on && port_vi_deterministic())
+			on = 0;
+	}
+	return on != 0;
+}
+
+void* mixer_loop(void*)
+{
+	port_crash_thread_init();
+	if (sms_switch_dsp_thread)
+		sms_switch_dsp_thread();
+	for (;;) {
+		{
+			std::unique_lock<std::mutex> lk(m.mu);
+			m.cv.wait(lk, [] { return m.job; });
+			m.job = false;
+		}
+		port_dspmix_render(m.outA, m.outB, m.n, m.master);
+		m.done.store(1, std::memory_order_release);
+		port_irq_kick();
+	}
+	return NULL;
+}
+
+// Interrupt source: the subframe the mixing thread finished.
+void mixer_poll()
+{
+	if (!m.done.load(std::memory_order_acquire))
+		return;
+	m.done.store(0, std::memory_order_relaxed);
+	m.busy.store(0, std::memory_order_relaxed);
+	g.subframesRendered++;
+	post(0xDCD10004u);
+	post(kPrefix | 0xFF00);
+	__DSPHandler(0, NULL);
