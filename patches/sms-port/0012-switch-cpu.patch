+// The graphics worker (SMS_GX_THREAD=1): the GX front end on a thread of its
+// own, as a GameCube's GPU reads its FIFO while the CPU goes on.
+//
+// The game's thread then only writes the command stream: its GX calls go
+// into the write-gather pipe as the FIFO bytes the hardware would read (the
+// way a display list is recorded), the API keeping its own copy of the
+// registers for the getters and the setters that change part of one. Filled
+// pieces of the pipe go to the worker, which parses them with the same code
+// as before (state, batches, textures, shaders, copies, presenting) and is
+// the GL thread's only producer.
+//
+// Port calls that are not FIFO bytes travel in the same stream as private
+// commands (call), so they happen in the order the game made them. What
+// needs an answer from the worker's side (peeks, GXDrawDone, reading the
+// picture back) first waits for the worker to finish what came before
+// (sync), and then runs on the game's thread while the worker is idle. Draw
+// sync callbacks (GXSetDrawSync) run in the game's interrupt context once the
+// worker reaches their token, with the pixel metric read at that point.
+#ifndef SMS_GX_THREAD_H
+#define SMS_GX_THREAD_H
+
+#include <cstdint>
+#include <cstring>
+#include <new>
+#include <type_traits>
+
+namespace gx {
+namespace gxt {
+
+extern bool g_on;  // set once, at the end of GXInit
+extern double g_workerWaitSeconds;  // the game's side waiting for the worker
+inline bool on() { return g_on; }
+bool onWorker();
+
+// GXInit, once its own setup is done: SMS_GX_THREAD=1 starts the worker.
+void start();
+
+// The pipe's bytes so far, to the worker.
+void publish();
+// publish, then wait until the worker has run everything before (`why`
+// names the caller in the log's counts).
+void sync(const char* why = "other");
+// A display copy was written: waits while the worker is more than a frame
+// behind (frameDone, from the worker as it executes one).
+void frameQueued();
+void frameDone();
+uint64_t framesQueued();  // display copies the game has written
+
+// fn(data, n) on the worker, in stream order (a private FIFO command).
+using HostFn = void (*)(const uint8_t* data, uint32_t n);
+void callRaw(HostFn fn, const void* data, uint32_t n);
+void callRaw2(HostFn fn, const void* a, uint32_t na, const void* b, uint32_t nb);  // the two pieces as one
+template <class F> void call(const F& f) {
+    static_assert(std::is_trivially_copyable<F>::value, "commands are copied bytewise");
+    callRaw(
+        [](const uint8_t* d, uint32_t) {
+            alignas(F) unsigned char buf[sizeof(F)];
+            memcpy(buf, d, sizeof(F));
+            (*reinterpret_cast<F*>(buf))();
+        },
+        &f, uint32_t(sizeof(F)));
+}
