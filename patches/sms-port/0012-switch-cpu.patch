+    if (s_rest.empty()) {
+        const uint32_t used = parseStream(c.data, c.len, &need);
+        if (used < c.len) s_rest.assign(c.data + used, c.data + c.len);
+        return;
+    }
+    s_rest.insert(s_rest.end(), c.data, c.data + c.len);
+    const uint32_t used = parseStream(s_rest.data(), uint32_t(s_rest.size()), &need);
+    s_rest.erase(s_rest.begin(), s_rest.begin() + used);
+}
+
+// Time the game's side spends waiting for the worker (sync, frameQueued).
+struct WaitTimer {
+    double t0 = monoSeconds();
+    ~WaitTimer() { g_workerWaitSeconds += monoSeconds() - t0; }
+};
+
+void* workerMain(void*) {
+    t_worker = true;
+    if (sms_switch_gx_thread) sms_switch_gx_thread();
+    for (;;) {
+        Chunk c;
+        {
+            std::unique_lock<std::mutex> lk(s_mu);
+            s_work.wait(lk, [] { return !s_queue.empty(); });
+            c = s_queue.front();
+            s_queue.pop_front();
+            s_busy = true;
+        }
+        runChunk(c);
+        {
+            std::lock_guard<std::mutex> lk(s_mu);
+            c.len = 0;
+            s_free.push_back(c);
+            s_busy = false;
+            if (s_queue.empty()) s_idle.notify_all();
+        }
+    }
+    return nullptr;
+}
+
+// Draw sync tokens the worker reached, for the game's side.
+struct Reached {
+    uint16_t token;
+    uint32_t metric;
+};
+std::mutex s_syncMu;
+std::vector<Reached> s_reached;
+std::atomic<uint32_t> s_lastToken{0};
+bool s_inCallback = false;  // game side
+uint32_t s_callbackMetric = 0;
+uint16_t s_callbackToken = 0;
+
+// Interrupt source, on the game's side: the callbacks of the tokens reached.
+void deliverDrawSyncs() {
+    // one token a pass: TDrawSyncManager's thread handles each (and peeks)
+    // before the next one is the last token
+    std::vector<Reached> now;
+    {
+        std::lock_guard<std::mutex> lk(s_syncMu);
+        if (s_reached.empty()) return;
+        now.push_back(s_reached.front());
+        s_reached.erase(s_reached.begin());
+        if (!s_reached.empty()) port_irq_kick();
+    }
+    for (const Reached& r : now) {
+        s_lastToken.store(r.token, std::memory_order_relaxed);
+        if (!drawSyncCallback) continue;
+        s_inCallback = true;
+        s_callbackMetric = r.metric;
+        s_callbackToken = r.token;
+        drawSyncCallback(r.token);
+        s_inCallback = false;
+    }
+}
+
+}  // namespace
+
+bool onWorker() { return t_worker; }
+
+void start() {
+    const char* e = getenv("SMS_GX_THREAD");
+    if (!(e && e[0] == '1') || g_on) return;
+    if (!port_irq_add_source || !port_irq_kick || !glt::active()) {
+        logmsg("graphics worker: not available here (no interrupt plumbing or GL thread)");
+        return;
+    }
+    // a thread of the host's own (std::thread's on the Switch did not start
+    // from here), with room for the parser's and the batches' frames
+    pthread_attr_t a;
+    pthread_attr_init(&a);
+    pthread_attr_setstacksize(&a, 1u << 20);
+    pthread_t th;
+    const int rc = pthread_create(&th, &a, workerMain, nullptr);
+    pthread_attr_destroy(&a);
+    if (rc != 0) {
+        logmsg("graphics worker: no thread (%d)", rc);
+        return;
+    }
+    pthread_detach(th);
+    port_irq_add_source(deliverDrawSyncs);
+    g_on = true;
+    logmsg("graphics worker: the GX front end runs on a thread of its own");
+}
+
+void publish() {
+    if (!g_on || onWorker()) return;
+    Chunk fresh{nullptr, 0, 0};
+    {
+        std::lock_guard<std::mutex> lk(s_mu);
+        if (!s_free.empty()) {
+            fresh = s_free.back();
+            s_free.pop_back();
+        }
+    }
+    if (!fresh.data) {
+        fresh.data = static_cast<uint8_t*>(malloc(kChunkBytes));
+        if (!fresh.data) fatal("out of memory for the graphics worker's stream");
+        fresh.cap = kChunkBytes;
+    }
+    Chunk out{nullptr, 0, 0};
+    uint8_t* buf = fresh.data;
+    uint32_t len = 0, cap = fresh.cap;
+    pipeTakeForWorker(&buf, &len, &cap);  // swaps: the old buffer comes back
+    out.data = buf;
+    out.len = len;
+    out.cap = cap;
+    std::lock_guard<std::mutex> lk(s_mu);
+    if (!out.len) {  // nothing written: the buffer handed in is simply back
+        s_free.push_back(out);
+        return;
+    }
+    s_queue.push_back(out);
+    s_work.notify_one();
+}
+
+// The game's waits for the worker by reason, logged every 600 frames.
+struct WaitCount {
+    const char* why;
+    uint32_t n;
+    double seconds;
+};
+WaitCount s_waits[16];
+void countWait(const char* why, double seconds) {
+    for (WaitCount& w : s_waits) {
+        if (!w.why || w.why == why || !strcmp(w.why, why)) {
+            w.why = why;
+            w.n++;
+            w.seconds += seconds;
+            return;
+        }
+    }
+}
+
+void sync(const char* why) {
+    if (!g_on || onWorker()) return;
+    publish();
+    struct Count {
+        const char* why;
+        double t0 = monoSeconds();
+        ~Count() { countWait(why, monoSeconds() - t0); }
+    } count{why};
+    WaitTimer tw;
+    std::unique_lock<std::mutex> lk(s_mu);
+    s_idle.wait(lk, [] { return s_queue.empty() && !s_busy; });
+}
+
+void frameQueued() {
+    if (!g_on || onWorker()) return;
+    publish();
+    s_framesQueued++;
+    if (s_framesQueued % 600 == 0) {
+        char line[512];
+        int k = snprintf(line, sizeof line, "graphics worker: waits per frame over 600:");
+        for (WaitCount& w : s_waits) {
+            if (!w.why) break;
+            k += snprintf(line + k, sizeof line - size_t(k), " %s %.2f (%.3f ms)", w.why, w.n / 600.0,
+                          w.seconds * 1000.0 / 600.0);
+            w.n = 0;
+            w.seconds = 0;
+        }
+        logmsg("%s", line);
+    }
+    struct Count {
+        double t0 = monoSeconds();
+        ~Count() { countWait("frame", monoSeconds() - t0); }
+    } count;
+    if (s_framesQueued - s_framesDone.load(std::memory_order_acquire) <= 1) return;
+    WaitTimer tw;
+    std::unique_lock<std::mutex> lk(s_mu);
+    s_frame.wait(lk, [] { return s_framesQueued - s_framesDone.load(std::memory_order_acquire) <= 1; });
+}
+
+uint64_t framesQueued() { return s_framesQueued; }
+
+void frameDone() {
+    if (!g_on) return;
+    s_framesDone.fetch_add(1, std::memory_order_release);
+    std::lock_guard<std::mutex> lk(s_mu);
+    s_frame.notify_all();
+}
+
+void callRaw(HostFn fn, const void* data, uint32_t n) { callRaw2(fn, data, n, nullptr, 0); }
+
+void callRaw2(HostFn fn, const void* a, uint32_t na, const void* b, uint32_t nb) {
+    uint8_t hdr[16] = {0xF1, 0, 0, 0};
+    const uint32_t n = na + nb;
+    memcpy(hdr + 4, &n, 4);
+    memcpy(hdr + 8, &fn, sizeof fn);
+    pipeWriteStream(hdr, sizeof hdr);
+    if (na) pipeWriteStream(static_cast<const uint8_t*>(a), na);
+    if (nb) pipeWriteStream(static_cast<const uint8_t*>(b), nb);
+}
+
+void drawSyncReached(uint16_t token, uint32_t metric) {
+    {
+        std::lock_guard<std::mutex> lk(s_syncMu);
+        s_reached.push_back({token, metric});
+    }
+    port_irq_kick();
+}
+
+uint16_t lastToken() { return uint16_t(s_lastToken.load(std::memory_order_relaxed)); }
+
+bool inDrawSyncCallbackToken(uint16_t* token) {
+    if (!s_inCallback) return false;
+    *token = s_callbackToken;
+    return true;
+}
+
+bool inDrawSyncCallback(uint32_t* metric) {
+    if (!s_inCallback) return false;
+    *metric = s_callbackMetric;
+    return true;
+}
+
+}  // namespace gxt
+}  // namespace gx
+
+// For the port (pad.cpp): the events are pumped by the worker as it presents.
+extern "C" int GXPC_GraphicsWorker(void) { return gx::gxt::on() ? 1 : 0; }
