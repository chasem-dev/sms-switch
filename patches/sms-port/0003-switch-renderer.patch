diff --git a/platform/gx/src/gx_render.cpp b/platform/gx/src/gx_render.cpp
index bd96a35..036d6fd 100644
--- a/platform/gx/src/gx_render.cpp
+++ b/platform/gx/src/gx_render.cpp
@@ -506,6 +506,31 @@ void main() {
   o_color = vec4(float(byteAt(k)), float(byteAt(k + 1)), float(byteAt(k + 2)), float(byteAt(k + 3))) / 255.0;
 }
 )";
+#ifdef __SWITCH__
+// The encoder with its divisions by run-time values done in floats and
+// corrected to the exact integer quotient (operands below 2^23): Mesa's
+// nouveau compiler makes an integer division a subroutine call on Maxwell,
+// which Switch emulators (Eden, yuzu forks) cannot run, and which is slow on
+// the console too. Divisions by constants are left to the compiler.
+static std::string switchEncodeFs() {
+    std::string s = kEncodeFs;
+    auto swap = [&s](const char* from, const char* to) {
+        const size_t at = s.find(from);
+        if (at != std::string::npos) s.replace(at, strlen(from), to);
+    };
+    swap("out vec4 o_color;\n",
+         "out vec4 o_color;\n"
+         "int D(int a, int b) { int q = int(float(a) / float(b)); int r = a - q * b;\n"
+         "  return r < 0 ? q - 1 : r >= b ? q + 1 : q; }\n");
+    swap("x * u_size.z / u_size.x", "D(x * u_size.z, u_size.x)");
+    swap("y * u_size.w / u_size.y", "D(y * u_size.w, u_size.y)");
+    swap("(u_size.x + tileW - 1) / tileW", "D(u_size.x + tileW - 1, tileW)");
+    swap("b / tileBytes", "D(b, tileBytes)");
+    swap("(tile % cols)", "(tile - D(tile, cols) * cols)");
+    swap("(tile / cols)", "D(tile, cols)");
+    return s;
+}
+#endif
 static GLuint s_encProg, s_encFbo, s_encTex;
 static GLint s_encUSize, s_encULayout, s_encUBytes;
 static int s_encRows = 0;
@@ -1181,7 +1206,11 @@ void rendererInit(float efbScale) {
     s_copyUMode = glGetUniformLocation(s_copyProg, "u_mode");
     s_copyURect = glGetUniformLocation(s_copyProg, "u_rect");
     s_copyUAlphaOne = glGetUniformLocation(s_copyProg, "u_alphaOne");
+#ifdef __SWITCH__
+    s_encProg = compileProgram(kCopyVs, switchEncodeFs().c_str());
+#else
     s_encProg = compileProgram(kCopyVs, kEncodeFs);
+#endif
     glUseProgram(s_encProg);
     glUniform1i(glGetUniformLocation(s_encProg, "u_src"), 0);
     const GLfloat wholeRect[4] = {0.0f, 0.0f, 1.0f, 1.0f};
