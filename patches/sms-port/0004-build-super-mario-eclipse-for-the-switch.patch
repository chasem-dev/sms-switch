diff --git a/platform/mods/eclipse/lib/CMakeLists.txt b/platform/mods/eclipse/lib/CMakeLists.txt
index 4ad103b..283eee2 100644
--- a/platform/mods/eclipse/lib/CMakeLists.txt
+++ b/platform/mods/eclipse/lib/CMakeLists.txt
@@ -38,7 +38,15 @@ set(_defs NTSCU KURIBO_NO_TYPES "BETTER_SMS_VERSION=\"v2.0\"" BETTER_SMS_CUSTOM_
 if(NOT SMS_ARCH)
   set(SMS_ARCH 32)
 endif()
-set(_arch -m${SMS_ARCH})
+if(NINTENDO_SWITCH)
+  # AArch64 has no -m64. The game's CPU and code model (devkitA64's
+  # NintendoSwitch.cmake): position independent, as an NRO is; newlib's
+  # headers in place of the host's.
+  set(_arch -march=armv8-a+crc+crypto -mtune=cortex-a57 -fPIE -ffunction-sections -fdata-sections
+    -D__SWITCH__ -nostdlibinc -isystem ${SMS_MODS_SYSROOT}/include)
+else()
+  set(_arch -m${SMS_ARCH})
+endif()
 if(SMS_ARCH STREQUAL "32")
   # SSE float math, as the game is built (x87 would round differently)
   list(APPEND _arch -malign-double -msse2 -mfpmath=sse)
@@ -92,6 +100,9 @@ target_compile_options(eclipse_objs PRIVATE ${_opts})
 # The partial links below run the compiler driver as a linker, for this target.
 if(APPLE AND CMAKE_OSX_ARCHITECTURES)
   set(_ld_arch -arch ${CMAKE_OSX_ARCHITECTURES})
+elseif(NINTENDO_SWITCH)
+  # devkitA64's ld (clang's bare-metal driver would pick ld.lld).
+  set(_ld_arch --target=aarch64-none-elf --ld-path=${CMAKE_LINKER})
 else()
   set(_ld_arch -m${SMS_ARCH})
 endif()
@@ -161,3 +172,10 @@ add_custom_command(OUTPUT ${_obj}
   COMMAND_EXPAND_LISTS VERBATIM)
 add_library(sms_eclipse STATIC ${_obj})
 set_target_properties(sms_eclipse PROPERTIES LINKER_LANGUAGE CXX)
+# The mods' plain new/delete renamed to the game's (cmake/eclipse.cmake), each
+# time the library is written.
+if(SMS_GAME_NEW_SYMS)
+  add_custom_command(TARGET sms_eclipse POST_BUILD
+    COMMAND ${CMAKE_OBJCOPY} --redefine-syms=${SMS_GAME_NEW_SYMS} $<TARGET_FILE:sms_eclipse>
+    COMMENT "Renaming the mods' global operator new/delete to the game's" VERBATIM)
+endif()
diff --git a/platform/mods/eclipse/lib/mod_ctors.ld b/platform/mods/eclipse/lib/mod_ctors.ld
index f0637a4..97bb72f 100644
--- a/platform/mods/eclipse/lib/mod_ctors.ld
+++ b/platform/mods/eclipse/lib/mod_ctors.ld
@@ -1,6 +1,8 @@
 /* Partial link of the code mods (-r): their static constructors, which the
- * port runs when the modules load (sms_mod_start), not at process start. */
+ * port runs when the modules load (sms_mod_start), not at process start.
+ * .init_array too: clang's bare-metal driver (the Switch's aarch64-none-elf)
+ * ignores -fno-use-init-array; elsewhere the mods have none. */
