Build Super Mario Eclipse (-DSMS_ECLIPSE=ON) for the Nintendo Switch.

- the mods' library: clang for aarch64-none-elf with devkitA64's newlib
  headers (no -m64), partially linked with devkitA64's ld and archived with
  its ar; clang and clang++ also found as clang-19/clang-22
- mod_ctors.ld also gathers .init_array: clang's bare-metal driver ignores
  -fno-use-init-array, and the mods' constructors otherwise ran at process
  start, with no sms_mod_ctors section for the port to find
- the mods' new/delete are renamed to the game's whenever their library is
  written (a post-build command in platform/mods/eclipse/lib), not in an
  ExternalProject step that ran only on the first build: a rebuilt library
  freed game-heap blocks with the host's free() (any host, any rebuild)
- the boot information the mods read at 0x800000xx (bus and core clocks,
  console type, the disc ID and its audio streaming flag) is read from
  port_mem1_base, which is not 0x80000000 where the loader is in the way
- SunshineHeaderInterface's TSmallEnemy::changeByJuice, doKeepDistance,
  isFindMario (u32, the game's bool) and isInhibitedForceMove (bool, the
  game's BOOL) declared as the decomp declares them (abi_check.py failed)
- BetterSunshineEngine's itoa(dst, num, base) renamed (sms_bse_itoa): linked
  into the program it replaced the C library's itoa(num, dst, base), which
  the Switch's SDL2 calls at start-up (a crash at address 0 on the console)

diff --git a/cmake/eclipse.cmake b/cmake/eclipse.cmake
index 386511c..bc901b0 100644
--- a/cmake/eclipse.cmake
+++ b/cmake/eclipse.cmake
@@ -11,8 +11,8 @@
 # Their headers describe the GameCube's layout; platform/mods/eclipse/shi-layout.patch
 # (tools/mods/shi_layout) re-lays their classes out as the port lays out the
 # game's, on 32- and 64-bit hosts.
-find_program(SMS_CLANGXX NAMES clang++)
-find_program(SMS_CLANG NAMES clang)
+find_program(SMS_CLANGXX NAMES clang++ clang++-22 clang++-19)
+find_program(SMS_CLANG NAMES clang clang-22 clang-19)
 if(NOT SMS_CLANGXX OR NOT SMS_CLANG)
   message(FATAL_ERROR "SMS_ECLIPSE needs clang/clang++ (Eclipse's sources are written for clang)")
 endif()
@@ -84,10 +84,22 @@ set(_eclipse_lib "${CMAKE_BINARY_DIR}/eclipse-build/libsms_eclipse.a")
 if(APPLE)
   set(_eclipse_platform_args -DCMAKE_OBJCOPY=${SMS_OBJCOPY} -DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}
     -DCMAKE_OSX_SYSROOT=${CMAKE_OSX_SYSROOT})
+elseif(NINTENDO_SWITCH)
+  # The Switch: clang for AArch64 with devkitA64's newlib headers, and
+  # devkitA64's binutils for the partial links and the archive (the host's
+  # do not know AArch64 objects).
+  set(_eclipse_platform_args -DCMAKE_SYSTEM_NAME=Generic -DCMAKE_SYSTEM_PROCESSOR=aarch64
+    -DCMAKE_C_COMPILER_TARGET=aarch64-none-elf -DCMAKE_CXX_COMPILER_TARGET=aarch64-none-elf
+    -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY -DNINTENDO_SWITCH=ON
+    -DSMS_MODS_SYSROOT=${DEVKITPRO}/devkitA64/aarch64-none-elf
+    -DCMAKE_OBJCOPY=${CMAKE_OBJCOPY} -DCMAKE_LINKER=${CMAKE_LINKER}
+    -DCMAKE_AR=${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ar
+    -DCMAKE_RANLIB=${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ranlib)
 else()
   set(_eclipse_platform_args -DCMAKE_OBJCOPY=${CMAKE_OBJCOPY})
 endif()
-list(APPEND _eclipse_platform_args -DPython3_EXECUTABLE=${Python3_EXECUTABLE})
+list(APPEND _eclipse_platform_args -DPython3_EXECUTABLE=${Python3_EXECUTABLE}
+  -DSMS_GAME_NEW_SYMS=${CMAKE_BINARY_DIR}/game_new_syms.txt)
 ExternalProject_Add(sms_eclipse_build
   SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/platform/mods/eclipse/lib
   BINARY_DIR ${CMAKE_BINARY_DIR}/eclipse-build
@@ -101,14 +113,14 @@ ExternalProject_Add(sms_eclipse_build
   INSTALL_COMMAND ""
   BUILD_BYPRODUCTS ${_eclipse_lib})
 # The mods' plain new/delete go to the game's heaps, like the game's own
-# (see the sms_game rename above). Their static constructors run when the
-# modules load (sms_mod_start), not at process start (platform/mods/eclipse/lib
+# (see the sms_game rename above): platform/mods/eclipse/lib renames them
+# whenever it writes the library (SMS_GAME_NEW_SYMS). Done here as a step
+# after the build, it ran only the first time, and a rebuilt library deleted
+# the game's blocks with the host's free(). Their static constructors run when
+# the modules load (sms_mod_start), not at process start (platform/mods/eclipse/lib
 # moves them to their own section): Kuribo runs a module's constructors when
 # it loads it, and BetterSunshineEngine's start threads and allocate from the
 # game's heaps.
-ExternalProject_Add_Step(sms_eclipse_build rename_new
-  COMMAND ${SMS_OBJCOPY} --redefine-syms=${CMAKE_BINARY_DIR}/game_new_syms.txt ${_eclipse_lib}
-  DEPENDEES build)
 
