+// The graphics presets: 1x, 2x, 1x with the texture packs, 2x with them
+// (the internal resolution and the packs' replacements, changed while the
+// game runs), and the gameplay frame rate. On the Switch, the left stick held
+// in (L3) and D-pad Right steps through the presets, L3 and D-pad Left
+// switches between 30 and 60 fps; the choices are kept in graphics.txt beside
+// the program (NAME=value lines, as env.txt, read at start).
+static std::string s_graphicsToast;
+static double s_graphicsToastUntil = 0;
+
+extern "C++" void gx::graphicsToastRender(int winW, int winH) {
+    static std::vector<uint8_t> px;
+    static std::string shown;
+    static int tw = 0, th = 0, glyph = 0;
+    if (s_graphicsToast.empty() || nowSeconds() > s_graphicsToastUntil) {
+        shown.clear();
+        return;
+    }
+    const int g = std::max(3, winH / 270);  // about 28 pixels high at 1080
+    const bool changed = s_graphicsToast != shown || g != glyph;
+    if (changed) {
+        static const uint8_t bg[4] = {15, 15, 15, 240}, accent[4] = {66, 150, 250, 255}, text[4] = {255, 255, 255, 255};
+        shown = s_graphicsToast;
+        glyph = g;
+        const int pad = 6 * g;
+        tw = gx::overlayTextWidth(shown.c_str()) * g + 2 * pad;
+        th = 7 * g + 2 * pad;
+        px.assign(size_t(tw) * th * 4, 0);
+        gx::overlayFillRect(px, tw, th, 0, 0, tw, th, bg);
+        gx::overlayFillRect(px, tw, th, 0, 0, 2 * g, th, accent);
+        gx::overlayText(px, tw, th, pad, pad, shown.c_str(), text, g);
+    }
+    // a little above the middle, clear of the HUD's counters and of the
+    // messages low in the window
+    gx::drawOverlayPanel(gx::OVERLAY_GRAPHICS_TOAST, changed ? px.data() : nullptr, tw, th, (winW - tw) / 2,
+                         winH * 3 / 10, 1, winW, winH);
+}
+
+#ifdef __SWITCH__
+static bool s_stickHeld[2];  // L3, R3 held (sms_gx_pump_events)
+// The gameplay frame rate (SMS_FRAME_RATE, the port's runtime; absent in the
+// GX tests). The game takes it as a stage starts, so a change shows from the
+// next area or level on.
+extern "C" __attribute__((weak)) int port_frame_rate;
+static void saveGraphicsSettings() {
+    if (FILE* f = fopen("graphics.txt", "w")) {
+        fprintf(f, "SMS_GX_SCALE=%d\nSMS_TEXTURE_PACKS_ACTIVE=%d\n", gx::efbScale() >= 2.0f ? 2 : 1,
+                gx::hiresEnabled() && gx::hiresActive() ? 1 : 0);
+        if (&port_frame_rate) fprintf(f, "SMS_FRAME_RATE=%d\n", port_frame_rate);
+        fclose(f);
+    }
+}
+static void showGraphicsMessage(const std::string& text) {
+    s_graphicsToast = text;
+    s_graphicsToastUntil = nowSeconds() + 2.5;
+    logmsg("%s", text.c_str());
+}
+static void toggleFrameRate() {
+    if (!&port_frame_rate) return;
+    port_frame_rate = port_frame_rate == 30 ? 60 : 30;
+    saveGraphicsSettings();
+    showGraphicsMessage(std::string("Frame rate: ") + (port_frame_rate == 30 ? "30" : "60") +
+                        " fps (from the next area)");
+}
+static void cycleGraphicsPreset() {
+    const bool packs = gx::hiresEnabled();  // a pack was found: the HD presets exist
+    const bool hd = packs && gx::hiresActive();
+    int preset = (gx::efbScale() >= 2.0f ? 1 : 0) + (hd ? 2 : 0);
+    preset = (preset + 1) % (packs ? 4 : 2);
+    const float scale = (preset & 1) ? 2.0f : 1.0f;
+    const bool wantHd = preset >= 2;
+    gx::rendererSetScale(scale);
+    if (packs) gx::hiresSetActive(wantHd);
+    saveGraphicsSettings();
+    showGraphicsMessage(std::string("Graphics: ") + (scale >= 2.0f ? "2x" : "1x") + (wantHd ? " + HD textures" : "") +
+                        (packs ? "" : " (no texture pack)"));
+}
+#endif
