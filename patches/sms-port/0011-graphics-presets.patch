+void hiresSetActive(bool on) {
+    if (on == s_active) return;
+    s_active = on;
+    if (on) return;
+    size_t freed = 0, n = 0;
+    for (auto it = s_repl.begin(); it != s_repl.end();) {
+        if (it->second.state != Replacement::READY) {
+            ++it;
+            continue;
+        }
+        glcForgetTexture(it->second.tex);
+        glDeleteTextures(1, &it->second.tex);
+        freed += it->second.bytes;
+        {
+            std::lock_guard<std::mutex> lk(s_mu);
+            s_requested.erase(it->first);
+        }
+        it = s_repl.erase(it);
+        n++;
+    }
+    s_bytes -= std::min(s_bytes, freed);
+    logmsg("texture pack: off, %zu replacements (%zu MiB) freed", n, freed >> 20);
+}
